#!/bin/sh
set -e
# On removal (not upgrade), restore DNS settings and stop the service.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if ! /usr/bin/fuck-ads disable >/dev/null; then
        echo "fuck-ads: 'fuck-ads disable' failed; stopping the service and removing its DNS settings directly" >&2
        # Stopping runs the unit's ExecStopPost hook, which restores DNS from
        # the recorded backup.
        systemctl disable --now fuck-ads.service || true
        if [ -f /etc/systemd/resolved.conf.d/90-fuck-ads.conf ]; then
            rm -f /etc/systemd/resolved.conf.d/90-fuck-ads.conf
            systemctl restart systemd-resolved.service || true
        fi
        if [ -f /etc/NetworkManager/conf.d/90-fuck-ads.conf ]; then
            rm -f /etc/NetworkManager/conf.d/90-fuck-ads.conf
            systemctl reload NetworkManager.service || true
        fi
        if grep -q "Generated by FuckAds" /etc/resolv.conf 2>/dev/null; then
            echo "fuck-ads: /etc/resolv.conf still points to FuckAds; the backup is in /var/lib/fuck-ads/system-state.json" >&2
        fi
    fi
    /usr/bin/fuck-ads browser uninstall --system >/dev/null 2>&1 || true
fi
exit 0
