<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fuckads.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fuck-ads</string>
        <string>daemon</string>
    </array>
    <!-- Starts as root ONLY to bind 127.0.0.1:53 (macOS refuses that to other
         users). The daemon switches to the unprivileged _fuck-ads account right
         after binding, before it reads any file or filter list. -->
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after crashes and any other non-zero exit, including exit 78
         (bad configuration), every ThrottleInterval seconds; not after a
         clean exit. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>18</integer>
    <key>StandardOutPath</key>
    <string>/Library/Logs/FuckAds/fuck-ads.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/FuckAds/fuck-ads.log</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>
</dict>
</plist>
