[Unit]
Description=FuckAds ad and tracker blocking DNS service
Documentation=https://github.com/PankajKrana/fuck-ads
# Give up after 5 failed starts in a minute instead of looping forever.
StartLimitIntervalSec=60
StartLimitBurst=5
After=network.target
Wants=network.target
# Start before name lookups are needed by other services.
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=notify
ExecStart=/usr/local/bin/fuck-ads daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# 78 = invalid configuration: do not restart in a loop.
RestartPreventExitStatus=78
# Route system DNS through the daemon once it is ready, and give the previous
# resolvers back whenever it stops for any reason (crash, failed start, plain
# `systemctl stop`), so a dead daemon never leaves the machine without DNS.
# `+` runs these as root outside the sandbox; `-` keeps a failure from
# failing the unit.
ExecStartPost=-+/usr/local/bin/fuck-ads _sync-dns
ExecStopPost=-+/usr/local/bin/fuck-ads _sync-dns

# Unprivileged service account; only allowed to bind port 53.
User=fuck-ads
Group=fuck-ads
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Writable locations.
RuntimeDirectory=fuck-ads
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/fuck-ads/data

# Sandboxing.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0022

# Resource limits: generous for a DNS cache, bounded against runaway growth.
MemoryMax=512M
TasksMax=64
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
